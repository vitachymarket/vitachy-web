---
import type { Locale } from '../lib/marketplaces';
import { MARKETPLACES } from '../lib/marketplaces';

interface Props {
  href: string;
  lang?: Locale;
  variant?: 'primary' | 'ghost' | 'card';
  label?: string;
}

const { href, lang = 'es', variant = 'primary', label } = Astro.props;
const tld = MARKETPLACES[lang].tld;
const text = label ?? `Comprar en amazon.${tld}`;

const base =
  'inline-flex items-center justify-center rounded-full font-semibold transition-colors';
const sizes = variant === 'card' ? 'px-5 py-2 text-sm' : 'px-7 py-3';
const variantClass =
  variant === 'ghost'
    ? 'border-[1.5px] border-ink text-ink hover:bg-ink hover:text-white'
    : 'bg-ink text-white hover:bg-[var(--accent-deep)]';
---
<a
  href={href}
  rel="sponsored noopener"
  target="_blank"
  class={`${base} ${sizes} ${variantClass}`}
>
  {text}
  <svg aria-hidden="true" viewBox="0 0 20 20" class="ml-2 h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M7 13L13 7M13 7H8M13 7V12" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
