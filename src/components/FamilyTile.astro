---
import type { Locale } from '../lib/marketplaces';
import { familyUrl, type FamilySlug } from '../lib/routes';

interface Props {
  slug: FamilySlug;
  nombre: string;
  subclaim?: string;
  imageUrl?: string;
  imageAlt?: string;
  lang?: Locale;
}

const { slug, nombre, subclaim, imageUrl, imageAlt, lang = 'es' } = Astro.props;
const href = familyUrl(slug, lang);
---
<a href={href} class="group block">
  <div class="aspect-square bg-paper-warm border border-line rounded-2xl overflow-hidden">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={imageAlt ?? nombre}
        width="800"
        height="800"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-contain transition-transform duration-[350ms] group-hover:scale-[1.04]"
      />
    ) : (
      <div class="h-full w-full flex items-center justify-center text-ink-soft text-sm">
        {nombre}
      </div>
    )}
  </div>
  <h3 class="display mt-4 text-lg font-semibold">{nombre}</h3>
  {subclaim && (
    <p class="mt-1 text-sm text-ink-soft">{subclaim}</p>
  )}
</a>
