---
import { resizedAmazonImage } from '../lib/images';

interface Image {
  url: string;
  posicion: number;
  alt: string;
}

interface Props {
  images: Image[];
  codigo: string;
}

const { images, codigo } = Astro.props;
const sorted = [...images].sort((a, b) => a.posicion - b.posicion);
const hasImages = sorted.length > 0;
---
<div class="gallery">
  <div class="gallery-main aspect-square bg-paper-warm border border-line rounded-2xl overflow-hidden">
    {hasImages ? (
      <div class="gallery-track" role="region" aria-label="Galería de imágenes" tabindex="0">
        {sorted.map((img, idx) => (
          <img
            src={resizedAmazonImage(img.url, 800)}
            alt={img.alt}
            width="800"
            height="800"
            loading={idx === 0 ? 'eager' : 'lazy'}
            fetchpriority={idx === 0 ? 'high' : undefined}
            decoding="async"
            data-idx={idx}
            class="gallery-slide"
          />
        ))}
      </div>
    ) : (
      <div class="h-full w-full flex items-center justify-center text-ink-soft">
        <span class="text-sm">Imagen de {codigo} próximamente</span>
      </div>
    )}
  </div>

  {sorted.length > 1 && (
    <div class="mt-4 grid grid-cols-7 gap-2">
      {sorted.map((img, idx) => (
        <button
          type="button"
          data-thumb-idx={idx}
          data-active={idx === 0 ? 'true' : 'false'}
          aria-label={`Ver imagen ${idx + 1} de ${sorted.length}`}
          class="gallery-thumb aspect-square overflow-hidden rounded-xl bg-paper-warm"
        >
          <img
            src={resizedAmazonImage(img.url, 200)}
            alt=""
            width="160"
            height="160"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain pointer-events-none"
          />
        </button>
      ))}
    </div>
  )}
</div>

<style>
  .gallery-main {
    position: relative;
  }
  .gallery-track {
    display: flex;
    height: 100%;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }
  .gallery-track:focus-visible {
    outline: 2.5px solid var(--ink);
    outline-offset: -2px;
    border-radius: 1rem;
  }
  .gallery-slide {
    scroll-snap-align: center;
    scroll-snap-stop: always;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery-thumb {
    border: 2px solid var(--line);
    transition: border-color 180ms ease, transform 180ms ease;
    cursor: pointer;
  }
  .gallery-thumb:hover {
    border-color: var(--ink-soft);
    transform: translateY(-1px);
  }
  .gallery-thumb[data-active='true'] {
    border-color: var(--ink);
  }
  .gallery-thumb[data-active='true']:hover {
    border-color: var(--ink);
    transform: none;
  }
  .gallery-thumb:focus-visible {
    outline: 2.5px solid var(--ink);
    outline-offset: 3px;
  }
</style>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('.gallery')) {
    const track = gallery.querySelector<HTMLElement>('.gallery-track');
    if (!track) continue;
    const slides = Array.from(track.querySelectorAll<HTMLImageElement>('.gallery-slide'));
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-thumb-idx]'));

    function setActive(idx: number) {
      for (const b of thumbs) {
        b.dataset.active = String(Number(b.dataset.thumbIdx) === idx);
      }
    }

    for (const btn of thumbs) {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.thumbIdx);
        const target = slides[idx];
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          setActive(idx);
        }
      });
    }

    if (slides.length > 1 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && e.intersectionRatio > 0.6) {
              const idx = Number((e.target as HTMLElement).dataset.idx);
              setActive(idx);
            }
          }
        },
        { root: track, threshold: 0.6 },
      );
      for (const s of slides) observer.observe(s);
    }
  }
</script>
