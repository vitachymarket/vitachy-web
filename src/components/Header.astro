---
import type { Locale } from '../lib/marketplaces';
import { LOCALES } from '../lib/marketplaces';
import {
  estanciaUrl,
  aboutUrl,
  homeUrl,
  familyUrl,
  ESTANCIAS,
  type EstanciaSlug,
} from '../lib/routes';
import { getUi, getFamilies } from '../lib/i18n';

interface Alternate { hreflang: string; href: string; }

interface Props {
  lang?: Locale;
  alternates?: Alternate[];
}
const { lang = 'es', alternates } = Astro.props;
const ui = getUi(lang);
const families = getFamilies(lang);

const langLabels: Record<Locale, string> = {
  es: 'Español',
  en: 'English',
  fr: 'Français',
  it: 'Italiano',
  de: 'Deutsch',
};
const shortCodes: Record<Locale, string> = {
  es: 'ES', en: 'EN', fr: 'FR', it: 'IT', de: 'DE',
};

// Build per-locale links. Use the alternates if provided (page-aware switching),
// otherwise fall back to the home URL in each locale.
function urlForLang(target: Locale): string {
  if (alternates) {
    const match = alternates.find((a) => a.hreflang === target);
    if (match) {
      try { return new URL(match.href).pathname + new URL(match.href).search; } catch { return match.href; }
    }
  }
  return homeUrl(target);
}

const langSwitch = LOCALES.map((target) => ({
  code: target,
  label: langLabels[target],
  short: shortCodes[target],
  href: urlForLang(target),
  active: target === lang,
}));

function familyLabel(slug: string): string {
  return families.find((f) => f.slug === slug)?.nombre ?? slug;
}

const estancias = (Object.keys(ESTANCIAS) as EstanciaSlug[]).map((key) => {
  const def = ESTANCIAS[key];
  return {
    key,
    label: ui.estancias[key].title,
    href: estanciaUrl(key, lang),
    families: def.families.map((slug) => ({
      slug,
      label: familyLabel(slug),
      href: familyUrl(slug, lang),
    })),
  };
});

const amazonStore = 'https://www.amazon.es/stores/Vitachy/page/';
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-line">
  <div class="max-w-6xl mx-auto px-5 h-16 flex items-center gap-6">
    <a href={homeUrl(lang)} class="flex items-center" aria-label={`Vitachy — ${ui.nav.home_label}`}>
      <img
        src="/brand/logo-web.png"
        alt="Vitachy"
        width="480"
        height="120"
        class="h-7 w-auto"
        decoding="async"
      />
    </a>

    <nav class="hidden md:flex items-center gap-1 ml-auto" aria-label="Principal">
      {estancias.map((e) => (
        <div class="nav-group relative">
          <a
            href={e.href}
            class="px-3 py-2 display text-[0.95rem] font-medium text-ink rounded-md hover:bg-paper-warm transition-colors"
            aria-haspopup={e.families.length > 1 ? 'true' : undefined}
          >
            {e.label}
          </a>
          {e.families.length > 1 && (
            <div class="nav-dropdown" role="menu" aria-label={e.label}>
              {e.families.map((f) => (
                <a
                  href={f.href}
                  role="menuitem"
                  class="block px-3 py-2 text-sm display text-ink rounded-md hover:bg-paper-warm transition-colors whitespace-nowrap"
                >
                  {f.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a
        href={aboutUrl(lang)}
        class="ml-2 px-3 py-2 display text-[0.95rem] font-medium text-ink rounded-md hover:bg-paper-warm transition-colors"
      >
        {ui.nav.about}
      </a>
    </nav>

    <div class="nav-group relative hidden md:block">
      <button
        type="button"
        class="inline-flex items-center gap-1 px-3 py-2 display text-[0.95rem] font-medium text-ink rounded-md hover:bg-paper-warm transition-colors"
        aria-haspopup="true"
        aria-label={`Language — ${langLabels[lang]}`}
      >
        {shortCodes[lang]}
        <svg aria-hidden="true" viewBox="0 0 12 12" class="h-2.5 w-2.5 nav-chevron">
          <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <div class="nav-dropdown" role="menu" aria-label="Languages">
        {langSwitch.map((l) => (
          <a
            href={l.href}
            role="menuitem"
            hreflang={l.code}
            lang={l.code}
            aria-current={l.active ? 'true' : undefined}
            class:list={[
              'block px-3 py-2 text-sm display rounded-md hover:bg-paper-warm transition-colors whitespace-nowrap',
              l.active ? 'text-ink font-semibold' : 'text-ink-soft',
            ]}
          >
            <span class="inline-block w-7 mr-1 text-xs uppercase tracking-wide opacity-70">{l.short}</span>
            {l.label}
          </a>
        ))}
      </div>
    </div>

    <a
      href={amazonStore}
      rel="sponsored noopener"
      target="_blank"
      class="hidden md:inline-flex items-center rounded-full bg-ink text-white px-5 py-2 text-sm font-semibold hover:bg-[var(--accent-deep)] transition-colors"
    >
      {ui.nav.buy_amazon}
    </a>

    <details class="md:hidden ml-auto">
      <summary class="list-none cursor-pointer p-2" aria-label={ui.nav.menu_open}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="7" x2="21" y2="7" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="17" x2="21" y2="17" />
        </svg>
      </summary>
      <div class="absolute left-0 right-0 top-16 bg-white border-b border-line shadow-sm">
        <nav class="max-w-6xl mx-auto px-5 py-4 flex flex-col gap-3" aria-label="Móvil">
          {estancias.map((e) => (
            <a href={e.href} class="display text-base font-medium py-1">{e.label}</a>
          ))}
          <a href={aboutUrl(lang)} class="display text-base font-medium py-1 pt-2 border-t border-line">{ui.nav.about}</a>
          <div class="pt-3 border-t border-line">
            <p class="text-xs uppercase tracking-[0.14em] text-ink-soft mb-2">Idiomas / Languages</p>
            <div class="flex flex-wrap gap-2">
              {langSwitch.map((l) => (
                <a
                  href={l.href}
                  hreflang={l.code}
                  lang={l.code}
                  aria-current={l.active ? 'true' : undefined}
                  class:list={[
                    'inline-flex items-center gap-1 px-3 py-1.5 rounded-full border text-sm',
                    l.active ? 'border-ink text-ink font-semibold' : 'border-line text-ink-soft',
                  ]}
                >
                  <span class="text-xs uppercase tracking-wide opacity-70">{l.short}</span>
                  <span>{l.label}</span>
                </a>
              ))}
            </div>
          </div>
          <a
            href={amazonStore}
            rel="sponsored noopener"
            target="_blank"
            class="mt-2 inline-flex items-center justify-center rounded-full bg-ink text-white px-5 py-2 text-sm font-semibold"
          >
            {ui.nav.buy_amazon}
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .nav-group::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.5rem;
  }
  .nav-dropdown {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    padding: 0.375rem;
    background: white;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    box-shadow: 0 14px 36px -16px rgba(22, 20, 15, 0.18);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 150ms ease,
      visibility 150ms ease;
    z-index: 50;
  }
  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    visibility: visible;
    opacity: 1;
  }
</style>
