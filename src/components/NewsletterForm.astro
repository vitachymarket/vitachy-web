---
import { LEGAL_URLS } from '../lib/routes';
import { getUi } from '../lib/i18n';
import type { Locale } from '../lib/marketplaces';

interface Props {
  lang: Locale;
  variant?: 'banner' | 'block';
}
const { lang, variant = 'block' } = Astro.props;
const ui = getUi(lang);

const TURNSTILE_SITE_KEY = '0x4AAAAAADgP8v7IolKcnuE-';
const action = `/api/subscribe?lang=${lang}`;
const privacyHref = LEGAL_URLS[lang].privacy;
---
{variant === 'banner' ? (
  <section class="bg-[var(--accent-tint)] border-t border-line">
    <div class="newsletter-host max-w-3xl mx-auto px-5 py-14 md:py-20 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
        {ui.newsletter.title}
      </p>
      <h2 class="display mt-3 text-2xl md:text-3xl font-bold leading-tight">
        {ui.newsletter.hub_title}
      </h2>
      <p class="mt-4 text-base md:text-lg text-ink-soft leading-[1.55] max-w-xl mx-auto">
        {ui.newsletter.intro}
      </p>
      <div data-newsletter-error class="hidden mt-5 rounded-xl bg-white border-2 border-[#c0392b] px-4 py-3 text-base text-[#7d1f15] leading-[1.5] text-left max-w-xl mx-auto font-medium flex items-start gap-3">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 flex-none text-[#c0392b]" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="10" cy="10" r="8" />
          <path d="M10 6v4m0 3h.01" stroke-linecap="round" />
        </svg>
        <span data-newsletter-error-text></span>
      </div>
      <form method="POST" action={action} class="newsletter-form mt-6 grid gap-4 max-w-xl mx-auto">
        <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
          <input type="email" name="email" required maxlength="160" placeholder={ui.newsletter.placeholder} autocomplete="email"
            class="newsletter-email rounded-full border border-line bg-white px-5 py-3 text-ink focus:border-ink focus:outline-none" />
          <button type="submit" class="rounded-full bg-ink text-white px-6 py-3 font-semibold hover:bg-[var(--accent-deep)] transition-colors">
            {ui.newsletter.cta}
          </button>
        </div>
        <label class="flex items-start gap-3 text-sm leading-[1.5] text-ink-soft cursor-pointer text-left">
          <input type="checkbox" name="consentimiento" value="si" required class="mt-0.5 h-4 w-4 accent-[var(--ink)]" />
          <span>
            {ui.newsletter.consent_pre}
            <a href={privacyHref} class="underline hover:text-ink">{ui.newsletter.consent_link}</a>
            {ui.newsletter.consent_post}
          </span>
        </label>
        <div class="cf-turnstile flex justify-center" data-sitekey={TURNSTILE_SITE_KEY} data-appearance="interaction-only" data-theme="light"></div>
      </form>
    </div>
  </section>
) : (
  <div class="newsletter-host rounded-2xl border border-line bg-white p-6 md:p-8 max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
      {ui.newsletter.title}
    </p>
    <h3 class="display mt-2 text-xl md:text-2xl font-bold leading-tight">{ui.newsletter.hub_title}</h3>
    <p class="mt-3 text-base text-ink-soft leading-[1.55]">{ui.newsletter.intro}</p>
    <div data-newsletter-error class="hidden mt-4 rounded-xl bg-white border-2 border-[#c0392b] px-4 py-3 text-base text-[#7d1f15] leading-[1.5] font-medium flex items-start gap-3">
      <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 flex-none text-[#c0392b]" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="10" cy="10" r="8" />
        <path d="M10 6v4m0 3h.01" stroke-linecap="round" />
      </svg>
      <span data-newsletter-error-text></span>
    </div>
    <form method="POST" action={action} class="newsletter-form mt-5 grid gap-4">
      <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
        <input type="email" name="email" required maxlength="160" placeholder={ui.newsletter.placeholder} autocomplete="email"
          class="newsletter-email rounded-full border border-line bg-paper px-5 py-3 text-ink focus:border-ink focus:outline-none" />
        <button type="submit" class="rounded-full bg-ink text-white px-6 py-3 font-semibold hover:bg-[var(--accent-deep)] transition-colors">
          {ui.newsletter.cta}
        </button>
      </div>
      <label class="flex items-start gap-3 text-sm leading-[1.5] text-ink-soft cursor-pointer">
        <input type="checkbox" name="consentimiento" value="si" required class="mt-0.5 h-4 w-4 accent-[var(--ink)]" />
        <span>
          {ui.newsletter.consent_pre}
          <a href={privacyHref} class="underline hover:text-ink">{ui.newsletter.consent_link}</a>
          {ui.newsletter.consent_post}
        </span>
      </label>
      <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-appearance="interaction-only" data-theme="light"></div>
    </form>
  </div>
)}

<script is:inline define:vars={{
  msgConsent: ui.newsletter.error_consent,
  msgEmail: ui.newsletter.error_email,
  msgTurnstile: ui.newsletter.error_turnstile,
  msgSend: ui.newsletter.error_send,
  consentRequired: ui.newsletter.consent_required_message,
}}>
  (function () {
    const hosts = document.querySelectorAll('.newsletter-host');
    if (!hosts.length) return;

    if (!document.querySelector('script[data-turnstile-loader]')) {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      s.async = true;
      s.defer = true;
      s.setAttribute('data-turnstile-loader', '1');
      document.head.appendChild(s);
    }

    const params = new URLSearchParams(window.location.search);
    const err = params.get('subscribe_err');
    if (err) {
      const messages = { consent: msgConsent, email: msgEmail, turnstile: msgTurnstile, send: msgSend };
      const text = messages[err] || msgSend;
      hosts.forEach((host) => {
        const box = host.querySelector('[data-newsletter-error]');
        const txt = host.querySelector('[data-newsletter-error-text]');
        if (box && txt) { txt.textContent = text; box.classList.remove('hidden'); }
      });
      const first = hosts[0];
      if (first) {
        requestAnimationFrame(() => {
          first.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      }
    }

    hosts.forEach((host) => {
      const consent = host.querySelector('input[name="consentimiento"]');
      if (consent) {
        consent.addEventListener('invalid', () => consent.setCustomValidity(consentRequired));
        consent.addEventListener('change', () => consent.setCustomValidity(''));
      }
    });
  })();
</script>
