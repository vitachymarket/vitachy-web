---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../ProductCard.astro';
import { homeUrl, ESTANCIAS, estanciaUrl, productUrl, hreflangFor, type EstanciaSlug, type FamilySlug, type ProductCode } from '../../lib/routes';
import { getUi } from '../../lib/i18n';
import type { Locale } from '../../lib/marketplaces';

interface Props {
  lang: Locale;
  estanciaKey: EstanciaSlug;
}
const { lang, estanciaKey } = Astro.props;
const ui = getUi(lang);
const estanciaDef = ESTANCIAS[estanciaKey];
const estanciaUi = ui.estancias[estanciaKey];

const allProducts = await getCollection('products', ({ id, data }) =>
  id.startsWith(`${lang}/`) && estanciaDef.families.includes(data.familia as FamilySlug),
);
const products = allProducts.map((p) => p.data).sort((a, b) => a.orden - b.orden);

const alternates = hreflangFor((l) => estanciaUrl(estanciaKey, l));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.breadcrumb.home, item: 'https://vitachy.com/' },
    { '@type': 'ListItem', position: 2, name: estanciaUi.title, item: `https://vitachy.com${Astro.url.pathname}` },
  ],
};
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: estanciaUi.title,
  itemListElement: products.map((p, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `https://vitachy.com${productUrl(p.codigo as ProductCode, lang)}`,
    name: p.nombre_corto ?? p.titulo,
  })),
};
---
<Base
  title={`${estanciaUi.title} — Vitachy`}
  description={estanciaUi.description_page}
  lang={lang}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
  alternates={alternates}
>
  <div class="max-w-6xl mx-auto px-5 pt-10 md:pt-14">
    <nav class="text-xs text-ink-soft" aria-label={ui.breadcrumb.home}>
      <a href={homeUrl(lang)} class="hover:underline">{ui.breadcrumb.home}</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span class="text-ink">{estanciaUi.title}</span>
    </nav>
  </div>

  <section class="max-w-6xl mx-auto px-5 pt-6 pb-16 md:pb-20">
    <h1 class="display text-3xl md:text-[2.25rem] font-bold leading-tight">
      {estanciaUi.title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-[1.65] text-ink-soft mb-10">
      {estanciaUi.description_page}
    </p>
    {products.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <ProductCard product={product} lang={lang} />
        ))}
      </div>
    ) : (
      <p class="text-ink-soft">—</p>
    )}
  </section>
</Base>
