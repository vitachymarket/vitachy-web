---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import ProductCard from '../ProductCard.astro';
import { estanciaUrl, aboutUrl, catalogUrl, hreflangFor, homeUrl, type EstanciaSlug } from '../../lib/routes';
import { resizedAmazonImage } from '../../lib/images';
import { getUi } from '../../lib/i18n';
import type { Locale } from '../../lib/marketplaces';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const ui = getUi(lang);

const allProducts = await getCollection('products', ({ id }) => id.startsWith(`${lang}/`));
const products = allProducts.map((p) => p.data).sort((a, b) => a.orden - b.orden);

const heroImage = {
  url: '/imgs/familia.webp',
  alt: 'Familia disfrutando de una ensalada con la aceitera Vitachy',
};

const destacados = (() => {
  const seen = new Set<string>();
  const out: typeof products = [];
  for (const p of products) {
    if (seen.has(p.familia)) continue;
    seen.add(p.familia);
    out.push(p);
    if (out.length === 4) break;
  }
  return out;
})();

const rooms: Array<{ key: EstanciaSlug; image: { url: string; alt: string } }> = [
  { key: 'cocina', image: { url: '/imgs/cocina.webp', alt: ui.estancias.cocina.title } },
  { key: 'bano',   image: { url: '/imgs/bano.webp',   alt: ui.estancias.bano.title } },
  { key: 'hogar',  image: { url: '/imgs/hogar.webp',  alt: ui.estancias.hogar.title } },
];

const lifestyle = {
  url: 'https://m.media-amazon.com/images/I/71IjC+4O3RL.jpg',
  alt: ui.home.about_title,
};

const alternates = hreflangFor((l) => homeUrl(l));

const organisationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vitachy',
  legalName: 'VITACHY SPAIN SL',
  url: 'https://vitachy.com',
  logo: 'https://vitachy.com/brand/logo.png',
  taxID: 'B55399679',
  slogan: ui.tagline,
};
---
<Base
  title={`Vitachy — ${ui.tagline}`}
  description={ui.home.hero_subtitle}
  lang={lang}
  jsonLd={organisationJsonLd}
  alternates={alternates}
>
  <section class="bg-[var(--accent-tint)]">
    <div class="max-w-6xl mx-auto px-5 py-20 md:py-24 grid gap-10 md:grid-cols-[1.1fr_1fr] md:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
          {ui.home.hero_eyebrow}
        </p>
        <h1 class="display mt-4 text-[2.5rem] md:text-[3.4rem] leading-[1.05] font-bold">
          {ui.home.hero_title}
        </h1>
        <p class="mt-5 text-lg leading-[1.65] text-ink-soft max-w-md">
          {ui.home.hero_subtitle}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={catalogUrl(lang)}
            class="inline-flex items-center rounded-full bg-ink text-white px-7 py-3 font-semibold hover:bg-[var(--accent-deep)] transition-colors"
          >
            {ui.cta.view_catalog}
          </a>
          <a
            href={aboutUrl(lang)}
            class="inline-flex items-center rounded-full border-[1.5px] border-ink text-ink px-7 py-3 font-semibold hover:bg-ink hover:text-white transition-colors"
          >
            {ui.cta.learn_about}
          </a>
        </div>
      </div>
      <div class="aspect-square bg-paper-warm border border-line rounded-2xl overflow-hidden">
        <img
          src={heroImage.url}
          alt={heroImage.alt}
          width="1000"
          height="1000"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <Section eyebrow={ui.home.rooms_eyebrow} title={ui.home.rooms_title}>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {rooms.map((room) => (
        <a href={estanciaUrl(room.key, lang)} class="group block">
          <div class="aspect-square bg-paper-warm border border-line rounded-2xl overflow-hidden">
            <img
              src={room.image.url}
              alt={room.image.alt}
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-[350ms] group-hover:scale-[1.04]"
            />
          </div>
          <h3 class="display mt-4 text-lg font-semibold">{ui.estancias[room.key].title}</h3>
          <p class="mt-1 text-sm text-ink-soft">{ui.estancias[room.key].subclaim_home}</p>
        </a>
      ))}
    </div>
  </Section>

  <Section eyebrow={ui.home.featured_eyebrow} title={ui.home.featured_title} tone="warm">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {destacados.map((product) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </div>
  </Section>

  <section class="bg-paper">
    <div class="max-w-6xl mx-auto px-5 py-16 md:py-20 grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
          {ui.home.about_eyebrow}
        </p>
        <h2 class="display mt-3 text-3xl md:text-[2.25rem] font-bold leading-tight">
          {ui.home.about_title}
        </h2>
        <p class="mt-5 text-lg leading-[1.65] text-ink-soft max-w-md">
          {ui.home.about_body}
        </p>
        <a
          href={aboutUrl(lang)}
          class="mt-6 inline-flex items-center rounded-full border-[1.5px] border-ink text-ink px-6 py-2.5 font-semibold hover:bg-ink hover:text-white transition-colors"
        >
          {ui.cta.read_more}
        </a>
      </div>
      <div class="aspect-[4/3] bg-paper-warm border border-line rounded-2xl overflow-hidden">
        <img
          src={resizedAmazonImage(lifestyle.url, 1000)}
          alt={lifestyle.alt}
          width="1000"
          height="750"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>
</Base>
