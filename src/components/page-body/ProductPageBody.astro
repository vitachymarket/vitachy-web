---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../Gallery.astro';
import AmazonCta from '../AmazonCta.astro';
import ProductCard from '../ProductCard.astro';
import { cleanBullet, cleanDescriptionHtml } from '../../lib/sanitize';
import { formatPrice, MARKETPLACES } from '../../lib/marketplaces';
import {
  estanciaUrl,
  homeUrl,
  productUrl,
  hreflangFor,
  familyToEstancia,
  type FamilySlug,
  type ProductCode,
} from '../../lib/routes';
import { getUi, getFamilyByCode } from '../../lib/i18n';
import type { Locale } from '../../lib/marketplaces';

interface ProductData {
  asin: string;
  codigo: string;
  familia: string;
  titulo: string;
  nombre_corto?: string;
  bullets: string[];
  descripcion_html: string;
  imagenes: Array<{ url: string; posicion: number; alt: string }>;
  precio: number | null;
  currency: string;
  amazon_url: string;
  rating: number | null;
  total_resenas: number | null;
  actualizado: string;
  en_stock?: boolean;
}

interface Props {
  lang: Locale;
  product: ProductData;
}

const { lang, product } = Astro.props;
const ui = getUi(lang);
const mp = MARKETPLACES[lang];

const familySlug = product.familia as FamilySlug;
const family = getFamilyByCode(lang, familySlug);
const familyName = family?.nombre ?? familySlug;
const estanciaKey = familyToEstancia(familySlug);
const estanciaUi = ui.estancias[estanciaKey];
const estanciaHref = estanciaUrl(estanciaKey, lang);

const cleanedBullets = product.bullets.map((b) => cleanBullet(b));
const cleanedDescription = cleanDescriptionHtml(product.descripcion_html);
const descriptionText = cleanedDescription.replace(/<[^>]+>/g, '').trim();

const priceText = product.precio !== null ? formatPrice(product.precio, lang, product.currency) : null;
const mainImage = product.imagenes.find((i) => i.posicion === 0) ?? product.imagenes[0];
const inStock = product.en_stock !== false;

const allProducts = await getCollection('products', ({ id, data }) =>
  id.startsWith(`${lang}/`) && data.familia === product.familia && data.codigo !== product.codigo,
);
const related = allProducts.map((p) => p.data).slice(0, 4);

const productJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  sku: product.codigo,
  name: product.titulo,
  brand: { '@type': 'Brand', name: 'Vitachy' },
  description: descriptionText.slice(0, 200),
  ...(product.imagenes.length > 0 ? { image: product.imagenes.map((i) => i.url) } : {}),
  offers: {
    '@type': 'Offer',
    url: product.amazon_url,
    priceCurrency: product.currency,
    availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
if (product.precio !== null) {
  (productJsonLd.offers as Record<string, unknown>).price = product.precio;
}
if (product.rating !== null && product.total_resenas !== null) {
  productJsonLd.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.total_resenas,
  };
}

const alternates = hreflangFor((l) => productUrl(product.codigo as ProductCode, l));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.breadcrumb.home, item: 'https://vitachy.com/' },
    { '@type': 'ListItem', position: 2, name: estanciaUi.title, item: `https://vitachy.com${estanciaHref}` },
    { '@type': 'ListItem', position: 3, name: product.nombre_corto ?? product.titulo, item: `https://vitachy.com${Astro.url.pathname}` },
  ],
};

function truncateAtWord(text: string, max: number): string {
  if (text.length <= max) return text;
  const slice = text.slice(0, max);
  const lastSpace = slice.lastIndexOf(' ');
  const cut = lastSpace > Math.floor(max * 0.6) ? lastSpace : max;
  return slice.slice(0, cut).replace(/[.,;:]$/, '') + '…';
}

const description = truncateAtWord(
  descriptionText.length > 0 ? descriptionText : product.titulo,
  155,
);
const priceCaption = `${ui.product.price_caption_prefix}.${mp.tld}`;
---
<Base
  title={`${product.nombre_corto ?? product.titulo} — Vitachy`}
  description={description}
  type="product"
  lang={lang}
  image={mainImage?.url}
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
  alternates={alternates}
>
  <div class="max-w-6xl mx-auto px-5 pt-10 md:pt-14">
    <nav class="text-xs text-ink-soft" aria-label={ui.breadcrumb.home}>
      <a href={homeUrl(lang)} class="hover:underline">{ui.breadcrumb.home}</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <a href={estanciaHref} class="hover:underline">{estanciaUi.title}</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span class="text-ink">{product.nombre_corto ?? product.codigo}</span>
    </nav>
  </div>

  <section class="max-w-6xl mx-auto px-5 pt-8 pb-16 md:pb-20 grid gap-10 lg:grid-cols-[5fr_4fr]">
    <Gallery images={product.imagenes} codigo={product.codigo} />

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
        {familyName}
      </p>
      <h1 class="display mt-3 text-2xl md:text-3xl font-bold leading-snug">
        {product.titulo}
      </h1>

      {!inStock && (
        <div class="mt-5 inline-flex items-center gap-2 rounded-full bg-ink/10 border border-ink/15 text-ink px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.08em]">
          <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="8" cy="8" r="6.5" />
            <path d="M8 4.5v4M8 11h.01" stroke-linecap="round" />
          </svg>
          {ui.product.out_of_stock_badge}
        </div>
      )}

      <div class:list={['mt-6 flex items-end gap-6', !inStock && 'opacity-60']}>
        {priceText && (
          <div>
            <p class="display text-3xl font-semibold text-ink leading-none">{priceText}</p>
            <p class="mt-1 text-xs text-ink-soft">{priceCaption}</p>
          </div>
        )}
      </div>

      <div class="mt-6">
        {inStock ? (
          <AmazonCta href={product.amazon_url} lang={lang} />
        ) : (
          <div class="space-y-3">
            <a
              href={product.amazon_url}
              rel="sponsored noopener"
              target="_blank"
              class="inline-flex items-center justify-center rounded-full border-[1.5px] border-ink text-ink px-7 py-3 font-semibold hover:bg-ink hover:text-white transition-colors"
            >
              {ui.cta.see_on_amazon}
            </a>
            <p class="text-sm text-ink-soft leading-[1.5] max-w-md">
              {ui.product.out_of_stock_help}
            </p>
          </div>
        )}
      </div>

      <ul class="mt-8 space-y-3 text-[0.95rem] leading-[1.55]">
        {cleanedBullets.map((bullet) => (
          <li class="flex gap-3">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-1.5 h-2 w-2 flex-none text-ink" fill="currentColor">
              <circle cx="10" cy="10" r="6" />
            </svg>
            <span set:html={bullet.html} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {cleanedDescription && (
    <section class="bg-paper-warm">
      <div class="max-w-6xl mx-auto px-5 py-16 md:py-20 grid gap-10 md:grid-cols-[1fr_2fr]">
        <h2 class="display text-2xl md:text-3xl font-bold leading-tight">
          {ui.product.description}
        </h2>
        <div class="prose prose-ink max-w-none text-ink-soft leading-[1.65]" set:html={cleanedDescription} />
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="max-w-6xl mx-auto px-5 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
        {ui.product.related_eyebrow_prefix} {familyName.toLowerCase()}
      </p>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 mt-10">
        {related.map((p) => (
          <ProductCard product={p} lang={lang} />
        ))}
      </div>
    </section>
  )}
</Base>
