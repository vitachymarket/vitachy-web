---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  homeUrl,
  productUrl,
  supportUrl,
  hreflangFor,
  type ProductCode,
} from '../../lib/routes';
import { resizedAmazonImage } from '../../lib/images';
import { getUi } from '../../lib/i18n';
import type { Locale } from '../../lib/marketplaces';
import NewsletterForm from '../NewsletterForm.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const ui = getUi(lang);

const all = await getCollection('products', ({ id }) => id.startsWith(`${lang}/`));
const products = all.map((p) => p.data).sort((a, b) => a.orden - b.orden);

const alternates = hreflangFor((l) => supportUrl(l));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.breadcrumb.home, item: 'https://vitachy.com/' },
    { '@type': 'ListItem', position: 2, name: ui.support.hub_title, item: `https://vitachy.com${Astro.url.pathname}` },
  ],
};
---
<Base
  title={`${ui.support.hub_title} — Vitachy`}
  description={ui.support.hub_intro}
  lang={lang}
  jsonLd={breadcrumbJsonLd}
  alternates={alternates}
>
  <div class="max-w-6xl mx-auto px-5 pt-10 md:pt-14">
    <nav class="text-xs text-ink-soft" aria-label={ui.breadcrumb.home}>
      <a href={homeUrl(lang)} class="hover:underline">{ui.breadcrumb.home}</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span class="text-ink">{ui.support.hub_title}</span>
    </nav>
  </div>

  <section class="max-w-6xl mx-auto px-5 pt-6 pb-10 md:pb-14">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
      {ui.support.title}
    </p>
    <h1 class="display mt-3 text-3xl md:text-[2.25rem] font-bold leading-tight">
      {ui.support.hub_title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-[1.65] text-ink-soft">
      {ui.support.hub_intro}
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-14">
    <ul class="grid gap-3 sm:grid-cols-2">
      {products.map((p) => {
        const main = p.imagenes.find((i) => i.posicion === 0) ?? p.imagenes[0];
        const thumb = main ? resizedAmazonImage(main.url, 240) : null;
        const href = `${productUrl(p.codigo as ProductCode, lang)}#instrucciones`;
        return (
          <li>
            <a
              href={href}
              class="group flex items-center gap-4 rounded-2xl border border-line bg-paper-warm hover:bg-white hover:border-ink/40 transition-colors p-3"
            >
              <div class="h-20 w-20 flex-none overflow-hidden rounded-xl bg-white border border-line">
                {thumb ? (
                  <img
                    src={thumb}
                    alt={main?.alt ?? p.nombre_corto ?? p.titulo}
                    width="240"
                    height="240"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                ) : null}
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-ink-soft">
                  {p.codigo}
                </p>
                <p class="display mt-1 text-base font-semibold text-ink leading-snug truncate">
                  {p.nombre_corto ?? p.titulo}
                </p>
                <p class="mt-1 text-xs text-ink-soft">
                  {ui.support.item_cta} →
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-20">
    <NewsletterForm lang={lang} variant="block" />
  </section>
</Base>
