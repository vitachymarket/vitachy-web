---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  ESTANCIAS,
  ESTANCIA_SLUG_BY_LANG,
  homeUrl,
  type EstanciaSlug,
  type FamilySlug,
} from '../../lib/routes';

const lang = 'es' as const;

export async function getStaticPaths() {
  return (Object.keys(ESTANCIAS) as EstanciaSlug[]).map((key) => ({
    params: { slug: ESTANCIA_SLUG_BY_LANG.es[key] },
    props: {
      estanciaKey: key,
    },
  }));
}

interface Props {
  estanciaKey: EstanciaSlug;
}

const { estanciaKey }: Props = Astro.props;
const estancia = ESTANCIAS[estanciaKey];

const allProducts = await getCollection('products', ({ id, data }) =>
  id.startsWith(`${lang}/`) && estancia.families.includes(data.familia as FamilySlug),
);

const products = allProducts
  .map((p) => p.data)
  .sort((a, b) => a.orden - b.orden);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://vitachy.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: estancia.label,
      item: `https://vitachy.com${Astro.url.pathname}`,
    },
  ],
};
---
<Base
  title={`${estancia.label} — Vitachy`}
  description={estancia.description}
  jsonLd={breadcrumbJsonLd}
>
  <div class="max-w-6xl mx-auto px-5 pt-10 md:pt-14">
    <nav class="text-xs text-ink-soft" aria-label="Migas de pan">
      <a href={homeUrl(lang)} class="hover:underline">Inicio</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span class="text-ink">{estancia.label}</span>
    </nav>
  </div>

  <section class="max-w-6xl mx-auto px-5 pt-6 pb-16 md:pb-20">
    <h1 class="display text-3xl md:text-[2.25rem] font-bold leading-tight">
      {estancia.label}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-[1.65] text-ink-soft mb-10">
      {estancia.description}
    </p>
    {products.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <ProductCard product={product} lang={lang} />
        ))}
      </div>
    ) : (
      <p class="text-ink-soft">Próximamente más productos en esta estancia.</p>
    )}
  </section>
</Base>
