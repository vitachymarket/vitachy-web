---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  FAMILY_SLUG_BY_LANG,
  productUrl,
  type FamilySlug,
  type ProductCode,
} from '../../lib/routes';

const lang = 'es' as const;

export async function getStaticPaths() {
  const families = await getCollection('families');
  return families.map((entry) => ({
    params: { slug: FAMILY_SLUG_BY_LANG.es[entry.data.slug as FamilySlug] },
    props: {
      family: entry.data,
    },
  }));
}

interface Props {
  family: {
    slug: string;
    nombre: string;
    orden: number;
    descripcion_corta: string;
  };
}

const { family }: Props = Astro.props;

const allProducts = await getCollection('products', ({ id, data }) => {
  return id.startsWith(`${lang}/`) && data.familia === family.slug;
});

const products = allProducts
  .map((p) => p.data)
  .sort((a, b) => a.orden - b.orden);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://vitachy.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: family.nombre,
      item: `https://vitachy.com${Astro.url.pathname}`,
    },
  ],
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: family.nombre,
  itemListElement: products.map((p, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `https://vitachy.com${productUrl(p.codigo as ProductCode, lang)}`,
    name: p.nombre_corto ?? p.titulo,
  })),
};
---
<Base
  title={`${family.nombre} — Vitachy`}
  description={family.descripcion_corta}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <Section eyebrow="Familia" title={family.nombre} tone="warm">
    <p class="max-w-2xl text-lg leading-[1.65] text-ink-soft -mt-6 mb-10">
      {family.descripcion_corta}
    </p>
    {products.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <ProductCard product={product} lang={lang} />
        ))}
      </div>
    ) : (
      <p class="text-ink-soft">Próximamente más productos en esta familia.</p>
    )}
  </Section>
</Base>
