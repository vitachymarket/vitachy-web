---
import FamilyPageBody from '../../../components/page-body/FamilyPageBody.astro';
import { FAMILY_SLUG_BY_LANG, type FamilySlug } from '../../../lib/routes';
import { getFamilies, type FamilyEntry } from '../../../lib/i18n';

export async function getStaticPaths() {
  const families = getFamilies('fr');
  return families.map((entry) => ({
    params: { slug: FAMILY_SLUG_BY_LANG.fr[entry.slug as FamilySlug] },
    props: { family: entry },
  }));
}

interface Props { family: FamilyEntry; }
const { family } = Astro.props as Props;
---
<FamilyPageBody lang="fr" family={family} />
