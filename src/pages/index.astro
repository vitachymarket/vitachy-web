---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProductCard from '../components/ProductCard.astro';
import { estanciaUrl, aboutUrl, ESTANCIAS, type EstanciaSlug } from '../lib/routes';
import { resizedAmazonImage } from '../lib/images';

const lang = 'es' as const;

const allProducts = await getCollection('products', ({ id }) => id.startsWith('es/'));
const products = allProducts
  .map((p) => p.data)
  .sort((a, b) => a.orden - b.orden);

const byCode = (code: string) => products.find((p) => p.codigo === code);
const mainOf = (code: string) => {
  const p = byCode(code);
  const img = p?.imagenes.find((i) => i.posicion === 0) ?? p?.imagenes[0];
  return img ? { url: img.url, alt: img.alt } : null;
};

const heroImage = mainOf('DA1');

const destacados = (() => {
  const seen = new Set<string>();
  const out: typeof products = [];
  for (const p of products) {
    if (seen.has(p.familia)) continue;
    seen.add(p.familia);
    out.push(p);
    if (out.length === 4) break;
  }
  return out;
})();

const rooms: Array<{ key: EstanciaSlug; title: string; subclaim: string; image: { url: string; alt: string } | null }> = [
  { key: 'cocina', title: 'Cocina', subclaim: 'Dispensadores y organizadores para el fregadero.', image: mainOf('DC1') },
  { key: 'bano',   title: 'Baño',   subclaim: 'Jabón en el lavabo, gel y champú en la ducha.',    image: mainOf('DB1') },
  { key: 'hogar',  title: 'Hogar',  subclaim: 'Pulverizadores, aceiteras y pastilleros.',         image: mainOf('P2A') },
];

const lifestyle = {
  url: 'https://m.media-amazon.com/images/I/71IjC+4O3RL.jpg',
  alt: 'Dispensadores Vitachy de gel, champú y acondicionador en una pared de ducha',
};

const organisationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vitachy',
  legalName: 'VITACHY SPAIN SL',
  url: 'https://vitachy.com',
  logo: 'https://vitachy.com/brand/logo.png',
  taxID: 'B55399679',
  slogan: 'Cada gota cuenta',
};
---
<Base
  title="Vitachy — Cada gota cuenta"
  description="Dispensadores recargables, bombas duraderas y diseño doméstico que dura. Cocina, baño, ducha y limpieza para aprovechar cada gota."
  jsonLd={organisationJsonLd}
>
  <section class="bg-[var(--accent-tint)]">
    <div class="max-w-6xl mx-auto px-5 py-20 md:py-24 grid gap-10 md:grid-cols-[1.1fr_1fr] md:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
          Vitachy
        </p>
        <h1 class="display mt-4 text-[2.5rem] md:text-[3.4rem] leading-[1.05] font-bold">
          Cada gota cuenta.
        </h1>
        <p class="mt-5 text-lg leading-[1.65] text-ink-soft max-w-md">
          Rellene, pulse, listo. Dispensadores, aceiteras y pulverizadores
          pensados para durar diez mil ciclos en su cocina, baño y ducha.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={estanciaUrl('cocina', lang)}
            class="inline-flex items-center rounded-full bg-ink text-white px-7 py-3 font-semibold hover:bg-[var(--accent-deep)] transition-colors"
          >
            Ver el catálogo
          </a>
          <a
            href={aboutUrl(lang)}
            class="inline-flex items-center rounded-full border-[1.5px] border-ink text-ink px-7 py-3 font-semibold hover:bg-ink hover:text-white transition-colors"
          >
            Conózcanos
          </a>
        </div>
      </div>
      <div class="aspect-square bg-white border border-line rounded-2xl overflow-hidden">
        {heroImage && (
          <img
            src={resizedAmazonImage(heroImage.url, 800)}
            alt={heroImage.alt}
            width="800"
            height="800"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-contain"
          />
        )}
      </div>
    </div>
  </section>

  <Section eyebrow="Para cada estancia" title="Diseño que se nota a diario.">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {rooms.map((room) => (
        <a href={estanciaUrl(room.key, lang)} class="group block">
          <div class="aspect-square bg-paper-warm border border-line rounded-2xl overflow-hidden">
            {room.image ? (
              <img
                src={resizedAmazonImage(room.image.url, 600)}
                alt={room.image.alt}
                width="600"
                height="600"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain transition-transform duration-[350ms] group-hover:scale-[1.04]"
              />
            ) : (
              <div class="h-full w-full flex items-center justify-center text-ink-soft text-sm">{room.title}</div>
            )}
          </div>
          <h3 class="display mt-4 text-lg font-semibold">{room.title}</h3>
          <p class="mt-1 text-sm text-ink-soft">{room.subclaim}</p>
        </a>
      ))}
    </div>
  </Section>

  <Section eyebrow="Destacados" title="Lo más vendido." tone="warm">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {destacados.map((product) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </div>
  </Section>

  <section class="bg-paper">
    <div class="max-w-6xl mx-auto px-5 py-16 md:py-20 grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
          Cada gota cuenta
        </p>
        <h2 class="display mt-3 text-3xl md:text-[2.25rem] font-bold leading-tight">
          Nuestra forma de entender la casa.
        </h2>
        <p class="mt-5 text-lg leading-[1.65] text-ink-soft max-w-md">
          No desperdiciar producto. No perder el tiempo. No tirar lo que aún
          sirve. Lo demás se lo dejamos a usted.
        </p>
        <a
          href={aboutUrl(lang)}
          class="mt-6 inline-flex items-center rounded-full border-[1.5px] border-ink text-ink px-6 py-2.5 font-semibold hover:bg-ink hover:text-white transition-colors"
        >
          Leer más
        </a>
      </div>
      <div class="aspect-[4/3] bg-paper-warm border border-line rounded-2xl overflow-hidden">
        <img
          src={resizedAmazonImage(lifestyle.url, 1000)}
          alt={lifestyle.alt}
          width="1000"
          height="750"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>
</Base>
