---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import AmazonCta from '../../components/AmazonCta.astro';
import ProductCard from '../../components/ProductCard.astro';
import { cleanBullet, cleanDescriptionHtml } from '../../lib/sanitize';
import { formatPrice } from '../../lib/marketplaces';
import {
  PRODUCT_SLUG_BY_LANG,
  estanciaUrl,
  familyToEstancia,
  ESTANCIAS,
  type ProductCode,
  type FamilySlug,
} from '../../lib/routes';

const lang = 'es' as const;

export async function getStaticPaths() {
  const all = await getCollection('products', ({ id }) => id.startsWith('es/'));
  const families = await getCollection('families');
  const familyByCode = new Map(
    all.map((p) => [p.data.codigo, p.data.familia]),
  );
  const familyMeta = new Map(families.map((f) => [f.data.slug, f.data]));

  return all.map((entry) => {
    const code = entry.data.codigo as ProductCode;
    const productSlugPart = PRODUCT_SLUG_BY_LANG.es[code];
    const slug = `${code.toLowerCase()}-${productSlugPart}`;
    return {
      params: { slug },
      props: {
        product: entry.data,
        familyName: familyMeta.get(familyByCode.get(entry.data.codigo) ?? '')?.nombre ?? '',
      },
    };
  });
}

interface Props {
  product: {
    asin: string;
    codigo: string;
    familia: string;
    titulo: string;
    nombre_corto?: string;
    bullets: string[];
    descripcion_html: string;
    imagenes: Array<{ url: string; posicion: number; alt: string }>;
    precio: number | null;
    currency: string;
    amazon_url: string;
    rating: number | null;
    total_resenas: number | null;
    actualizado: string;
  };
  familyName: string;
}

const { product, familyName } = Astro.props;

const familySlug = product.familia as FamilySlug;
const estanciaKey = familyToEstancia(familySlug);
const estancia = ESTANCIAS[estanciaKey];
const estanciaHref = estanciaUrl(estanciaKey, lang);

const cleanedBullets = product.bullets.map((b) => cleanBullet(b));
const cleanedDescription = cleanDescriptionHtml(product.descripcion_html);

const priceText = product.precio !== null ? formatPrice(product.precio, lang) : null;

const allProducts = await getCollection('products', ({ id, data }) => {
  return id.startsWith(`${lang}/`) && data.familia === product.familia && data.codigo !== product.codigo;
});
const related = allProducts.map((p) => p.data).slice(0, 4);

const productJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  sku: product.codigo,
  name: product.titulo,
  brand: { '@type': 'Brand', name: 'Vitachy' },
  description: product.descripcion_html.replace(/<[^>]+>/g, '').slice(0, 200),
  offers: {
    '@type': 'Offer',
    url: product.amazon_url,
    priceCurrency: product.currency,
    availability: 'https://schema.org/InStock',
  },
};
if (product.precio !== null) {
  (productJsonLd.offers as Record<string, unknown>).price = product.precio;
}
if (product.rating !== null && product.total_resenas !== null) {
  productJsonLd.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.total_resenas,
  };
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://vitachy.com/' },
    { '@type': 'ListItem', position: 2, name: estancia.label, item: `https://vitachy.com${estanciaHref}` },
    { '@type': 'ListItem', position: 3, name: product.nombre_corto ?? product.titulo, item: `https://vitachy.com${Astro.url.pathname}` },
  ],
};

const description = product.bullets[0]?.replace(/^[^a-zA-ZÁÉÍÓÚÜÑáéíóúüñ]+/, '').slice(0, 155) ?? product.titulo.slice(0, 155);
---
<Base
  title={`${product.nombre_corto ?? product.titulo} — Vitachy`}
  description={description}
  type="product"
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-6xl mx-auto px-5 pt-10 md:pt-14">
    <nav class="text-xs text-ink-soft" aria-label="Migas de pan">
      <a href="/" class="hover:underline">Inicio</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <a href={estanciaHref} class="hover:underline">{estancia.label}</a>
      <span class="mx-2" aria-hidden="true">›</span>
      <span class="text-ink">{product.nombre_corto ?? product.codigo}</span>
    </nav>
  </div>

  <section class="max-w-6xl mx-auto px-5 pt-8 pb-16 md:pb-20 grid gap-10 lg:grid-cols-[5fr_4fr]">
    <Gallery images={product.imagenes} codigo={product.codigo} />

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
        {familyName}
      </p>
      <h1 class="display mt-3 text-2xl md:text-3xl font-bold leading-snug">
        {product.titulo}
      </h1>

      <div class="mt-6 flex items-end gap-6">
        {priceText && (
          <div>
            <p class="display text-3xl font-semibold text-ink leading-none">{priceText}</p>
            <p class="mt-1 text-xs text-ink-soft">Precio en amazon.es</p>
          </div>
        )}
      </div>

      <div class="mt-6">
        <AmazonCta href={product.amazon_url} lang={lang} />
      </div>

      <ul class="mt-8 space-y-3 text-[0.95rem] leading-[1.55]">
        {cleanedBullets.map((bullet) => (
          <li class="flex gap-3">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-1.5 h-2 w-2 flex-none text-ink" fill="currentColor">
              <circle cx="10" cy="10" r="6" />
            </svg>
            <span set:html={bullet.html} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {cleanedDescription && (
    <section class="bg-paper-warm">
      <div class="max-w-6xl mx-auto px-5 py-16 md:py-20 grid gap-10 md:grid-cols-[1fr_2fr]">
        <h2 class="display text-2xl md:text-3xl font-bold leading-tight">
          Descripción
        </h2>
        <div class="prose prose-ink max-w-none text-ink-soft leading-[1.65]" set:html={cleanedDescription} />
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="max-w-6xl mx-auto px-5 py-16 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
        También en {familyName.toLowerCase()}
      </p>
      <h2 class="display mt-3 text-2xl md:text-3xl font-bold leading-tight mb-10">
        Productos relacionados
      </h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((p) => (
          <ProductCard product={p} lang={lang} />
        ))}
      </div>
    </section>
  )}
</Base>
