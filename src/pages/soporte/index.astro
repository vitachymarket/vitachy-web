---
import '../../styles/global.css';

const langs = [
  { code: 'es', label: 'Español',  flag: '🇪🇸', url: '/es/soporte/' },
  { code: 'en', label: 'English',  flag: '🇬🇧', url: '/en/support/' },
  { code: 'fr', label: 'Français', flag: '🇫🇷', url: '/fr/assistance/' },
  { code: 'it', label: 'Italiano', flag: '🇮🇹', url: '/it/assistenza/' },
  { code: 'de', label: 'Deutsch',  flag: '🇩🇪', url: '/de/support/' },
];
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Vitachy — Soporte / Support / Assistance / Assistenza / Support</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#16140F" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('vitachy_lang');
          var map = {
            es: '/es/soporte/',
            en: '/en/support/',
            fr: '/fr/assistance/',
            it: '/it/assistenza/',
            de: '/de/support/',
          };
          if (stored && map[stored]) location.replace(map[stored]);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-paper-warm text-ink antialiased min-h-screen flex flex-col">
    <main class="flex-1 flex items-center justify-center px-5 py-12">
      <div class="w-full max-w-md">
        <div class="flex justify-center mb-8">
          <img
            src="/brand/logo-web.png"
            alt="Vitachy"
            width="480"
            height="120"
            class="h-8 w-auto"
            decoding="async"
          />
        </div>

        <h1 class="display text-center text-2xl font-bold leading-tight">
          Soporte · Support
        </h1>
        <p class="mt-3 text-center text-sm text-ink-soft leading-[1.5]">
          Elige tu idioma · Choose your language · Choisissez votre langue · Scegli la lingua · Wähle deine Sprache
        </p>

        <ul class="mt-8 space-y-3" id="lang-list">
          {langs.map((l) => (
            <li>
              <a
                href={l.url}
                hreflang={l.code}
                lang={l.code}
                data-lang={l.code}
                class="flex items-center justify-between gap-4 rounded-2xl bg-white border border-line px-5 py-4 hover:border-ink/40 transition-colors"
              >
                <span class="flex items-center gap-3">
                  <span aria-hidden="true" class="text-2xl">{l.flag}</span>
                  <span class="display font-semibold text-ink">{l.label}</span>
                </span>
                <svg aria-hidden="true" viewBox="0 0 20 20" class="h-5 w-5 text-ink-soft" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-10 text-center text-xs text-ink-soft">
          VITACHY SPAIN SL · B55399679
        </p>
      </div>
    </main>

    <script is:inline>
      document.querySelectorAll('#lang-list a[data-lang]').forEach(function (el) {
        el.addEventListener('click', function () {
          try { localStorage.setItem('vitachy_lang', el.getAttribute('data-lang')); } catch (e) {}
        });
      });
    </script>
  </body>
</html>
